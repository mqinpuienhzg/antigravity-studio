{
  "name": "antigravity-studio",
  "version": "11.2.1",
  "description": "Clear Liquid Glass & 60FPS Live Video Customizer for Google Antigravity IDE & Chat — Developed by mqinpuienhzg",
  "license": "MIT",
  "homepage": "https://github.com/mqinpuienhzg/antigravity-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mqinpuienhzg/antigravity-studio.git"
  },
  "bugs": {
    "url": "https://github.com/mqinpuienhzg/antigravity-studio/issues"
  },
  "keywords": [
    "antigravity",
    "antigravity-ide",
    "liquid-glass",
    "live-wallpaper",
    "theme-customizer",
    "electron",
    "vscode-theme",
    "mqinpuienhzg"
  ],
  "author": {
    "name": "mqinpuienhzg",
    "url": "https://github.com/mqinpuienhzg"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5179",
    "build:ui": "vite build",
    "start": "electron .",
    "dev": "concurrently -k \"vite --port 5179\" \"wait-on http://127.0.0.1:5179 && electron .\"",
    "dist": "electron-builder --win portable --x64 --publish never",
    "build:exe": "vite build && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "io.antigravity.studio",
    "productName": "Antigravity Studio",
    "compression": "store",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-ui/**/*",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Antigravity-Studio-Portable.exe",
      "splashImage": "build/splash.bmp"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  }
}
